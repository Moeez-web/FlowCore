# Server
PORT=3000

# SQLite database file path (relative to project root)
DB_PATH=./data/flowcore.db

# OpenRouter — only required from Phase E onward
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Model used for "Why this matters" summaries
OPENROUTER_SOTA_MODEL=google/gemini-2.5-flash

# Firecrawl — website scraping for competitor blogs/landing pages
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Serper — Google SERP API for keyword rank tracking
# Get a key at https://serper.dev (free tier: 2500 queries/mo)
SERP_API_KEY=

# Poller scheduler — set to '0' to disable all pollers
POLLERS_ENABLED=1

# Apify — YouTube, TikTok, Google Ads, Meta Ads polling
# Get a token at https://apify.com (free tier: $5 platform credit/mo)
APIFY_API_TOKEN=

# Override default intervals (milliseconds)
# FIRECRAWL_INTERVAL_MS=43200000  # 12 hours
# SERPER_INTERVAL_MS=86400000    # 24 hours
# MOZ_INTERVAL_MS=86400000       # 24 hours
# YOUTUBE_INTERVAL_MS=86400000   # 24 hours
# TIKTOK_INTERVAL_MS=86400000    # 24 hours
# GOOGLE_ADS_INTERVAL_MS=86400000 # 24 hours
# META_ADS_INTERVAL_MS=86400000   # 24 hours
